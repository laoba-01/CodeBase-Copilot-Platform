# ── Server ──
PORT=8080
JWT_SECRET=  # REQUIRED: generate with: openssl rand -base64 48
CORS_ORIGIN=https://your-domain.com  # your Cloudflare domain
DEV_MODE=true  # set to false in production to disable dev-login

# ── Cloudflare Tunnel ──
# 1. Go to https://one.dash.cloudflare.com → Networks → Tunnels → Create
# 2. Choose "Cloudflared", name it, copy the tunnel token
# 3. In the tunnel config, set Public Hostname → your-domain.com → http://localhost:8080
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ── GitHub OAuth ──
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Gitee OAuth (码云) ──
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=https://your-domain.com/auth/gitee/callback

# ── Database ──
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable

# ── Redis ──
REDIS_URL=redis://:copilot-redis@localhost:6379

# ── Embedding ──
EMBEDDING_ADDR=localhost:50051

# ── Git clone ──
GIT_SSL_VERIFY=true  # set to false only in air-gapped environments with self-signed certs
# GIT_PROXY=  # optional HTTP proxy for git clone

# ── LLM ──
LLM_PROVIDER=claude    # or deepseek
LLM_API_KEY=your_api_key
LLM_MODEL=claude-sonnet-5
