# Server
PORT=8080
JWT_SECRET=change-me-in-production  # minimum 16 chars, must override in production
CORS_ORIGIN=http://localhost:8080
DEV_MODE=true  # set to false in production to disable dev-login

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Gitee OAuth (码云)
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=http://localhost:8080/auth/gitee/callback

# Database
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable

# Redis
REDIS_URL=redis://:copilot-redis@localhost:6379

# Embedding
EMBEDDING_ADDR=localhost:50051

# LLM
LLM_PROVIDER=claude    # or deepseek
LLM_API_KEY=your_api_key
LLM_MODEL=claude-sonnet-5
